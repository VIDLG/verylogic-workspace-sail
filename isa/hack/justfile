set default-list := true

# List bundled Hack programs.
list:
    python tools/workflow.py list

# Type-check the Hack Sail model.
check:
    python tools/workflow.py check

# Assemble a program; comments: none, summary (default), or full.
assemble program comments="summary":
    python tools/workflow.py assemble {{ program }} --comments {{ comments }}

alias a := assemble

# Execute a program; comments: none, summary (default), or full.
run program comments="summary":
    python tools/workflow.py run {{ program }} --comments {{ comments }}

alias r := run

# Run unit tests and every bundled program's Sail assertions.
test:
    python tools/workflow.py test

# Remove generated Hack build artifacts.
clean:
    python tools/workflow.py clean
