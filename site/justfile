set default-list := true

# Install the locked Rspress dependencies.
install:
    npm ci

# Report known dependency vulnerabilities.
audit:
    npm audit

# Start the Rspress development server.
dev:
    npm run dev

# Build the static documentation site into dist/.
build:
    npm run build

# Preview the built documentation site.
preview:
    npm run preview

# Remove generated site artifacts.
clean:
    rm -rf dist
