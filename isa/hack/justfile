set default-list := true

# List bundled Hack programs.
list:
    python tools/workflow.py list

# Type-check both Hack Sail profiles, or pass --profile hack16/hack32.
check *options:
    python tools/workflow.py check {{ options }}

# Assemble a program; optional metadata overrides follow the comment level.
assemble program comments="summary" *options:
    python tools/workflow.py assemble {{ program }} --comments {{ comments }} {{ options }}

alias a := assemble

# Execute a program; optional CLI overrides follow the comment level.
run program comments="summary" *options:
    python tools/workflow.py run {{ program }} --comments {{ comments }} {{ options }}

alias r := run

# Run the complete regression; end-to-end program builds type-check the model again.
test:
    python tools/workflow.py test

# Remove generated Hack build artifacts.
clean:
    python tools/workflow.py clean
